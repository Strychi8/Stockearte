# =============================================================================
# STOCKEARTE - VARIABLES DE ENTORNO (PLANTILLA)
# Copiar este archivo a .env y completar con las credenciales correspondientes:
#   Windows: copy .env.example .env
#   Linux/Mac: cp .env.example .env
# =============================================================================

# Base de datos PostgreSQL
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# API Gateway / Controlador REST (Node.js)
PORT=

# Direcciones de Microservicios gRPC (para ejecución local sin Docker)
USUARIOS_URL=
PRODUCTOS_URL=
TIENDAS_URL=

# URL base consumida por el cliente Frontend
VITE_API_URL=
